[Unit]
Description=Aiursoft ChessServer Web Application
After=network.target

[Service]
WorkingDirectory=/usr/share/aiursoft-chessServer
ExecStart=/usr/bin/dotnet /usr/share/aiursoft-chessServer/Aiursoft.ChessServer.dll --urls http://*:5000
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=aiursoft-chessServer
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=HOME=/var/lib/aiursoft-chessServer

[Install]
WantedBy=multi-user.target
