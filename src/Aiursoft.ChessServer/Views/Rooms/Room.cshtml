@model Aiursoft.ChessServer.Models.ViewModels.ManagedRoomViewModel
@if (Model.Game == null) { <partial name="_ChessIdentity" /> }
@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/node_modules/%40chrisoakman/chessboardjs/dist/chessboard-1.0.0.min.css" />
    <link rel="stylesheet" href="~/css/chess.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/room.css" asp-append-version="true" />
    <link rel="modulepreload" href="~/scripts/chessboard/chessboard.js" asp-append-version="true" data-chess-module="board" />
    <link rel="modulepreload" href="~/node_modules/chess.js/dist/esm/chess.js" asp-append-version="true" data-chess-module="rules" />
}
<div id="managed-room" class="@(Model.Game != null ? "room-in-game" : "")" data-room-id="@Model.Id" data-game-id="@Model.Game?.Id">
    <header class="room-toolbar">
        <div class="room-heading"><a asp-controller="Lobby" asp-action="Index" class="btn btn-sm btn-link">@Localizer["Lobby"]</a><h1 id="room-name" class="h5 mb-0">@Model.Message</h1><span id="room-stage" class="badge bg-secondary"></span></div>
        <div class="d-flex gap-2"><button id="show-room-people" class="btn btn-sm btn-outline-secondary" type="button" hidden>@Localizer["People"]</button><button id="share-room" class="btn btn-sm btn-outline-secondary" type="button">@Localizer["Share"]</button></div>
    </header>
    <p id="room-error" class="text-danger" role="alert" hidden></p>
    <div class="room-actions d-flex flex-wrap gap-2 mb-3">
            <button id="start-room" data-room-host class="btn btn-sm btn-primary" type="button">@Localizer["Start game"]</button>
            <button id="next-room-game" data-room-host class="btn btn-sm btn-primary" type="button" hidden>@Localizer["Prepare next game"]</button>
            <button id="retry-room-computer" data-room-host class="btn btn-sm btn-outline-primary" type="button" hidden>@Localizer["Retry computer move"]</button>
            <button id="interrupt-room" data-room-host class="btn btn-sm btn-outline-danger" type="button" hidden>@Localizer["Stop this game"]</button>
            <a id="room-history" class="btn btn-sm btn-outline-primary" hidden>@Localizer["Replay"]</a>
            <button id="leave-room" class="btn btn-sm btn-outline-secondary" type="button">@Localizer["Leave room"]</button>
    </div>
    <div class="room-preparation">
        <div class="advanced-game">
            @if (Model.Game != null) { @await Html.PartialAsync("~/Views/Games/GetHtml.cshtml", Model.Game) }
            <section id="room-roster" hidden="@(Model.Game != null)" aria-label="@Localizer["Players and observers"]">
                <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0">@Localizer["Players"]</h2><button id="swap-seats" data-room-host class="btn btn-sm btn-outline-secondary" type="button">@Localizer["Swap colors"]</button></div>
                <div class="row g-3"><div class="col-sm-6"><h3 id="white-seat-label" class="h6">@Localizer["White"]</h3><div id="white-seat" class="room-seat" data-drop-seat="white"></div></div><div class="col-sm-6"><h3 id="black-seat-label" class="h6">@Localizer["Black"]</h3><div id="black-seat" class="room-seat" data-drop-seat="black"></div></div></div>
                <p id="room-color-note" class="small text-muted mt-2" hidden>@Localizer["Colors are assigned when the game starts."]</p>
                <h2 class="h6 mt-4">@Localizer["Observers"]</h2><div id="room-observers" class="room-observers" data-drop-seat="observer"></div>
            </section>
            <details id="room-chat" class="room-chat mt-3" hidden><summary>@Localizer["Chat"]</summary><div class="pt-2">
                <div id="room-messages" class="chess-messages" role="log" aria-live="polite"></div>
                <form id="room-chat-form" class="d-flex gap-2 mt-2" hidden><input id="room-chat-input" class="form-control" maxlength="2000" aria-label="@Localizer["Message"]" autocomplete="off" /><button class="btn btn-primary" type="submit">@Localizer["Send"]</button></form>
            </div></details>
        </div>
        <aside id="room-settings-panel" class="room-settings" hidden="@(Model.Game != null)">
            <h2 class="h5">@Localizer["Room settings"]</h2>
            <form id="room-settings">
                <fieldset id="settings-fields">
                    <label for="room-title" class="form-label">@Localizer["Room name"]</label><input id="room-title" name="Name" maxlength="80" required class="form-control mb-3" />
                    <label for="room-minutes" class="form-label">@Localizer["Time per player"]</label><select id="room-minutes" name="Minutes" class="form-select mb-3"><option value="0">@Localizer["Unlimited"]</option><option value="3">@Localizer["3 minutes"]</option><option value="5">@Localizer["5 minutes"]</option><option value="10">@Localizer["10 minutes"]</option><option value="15">@Localizer["15 minutes"]</option></select>
                    <label for="room-increment" class="form-label">@Localizer["Increment per move"]</label><select id="room-increment" name="IncrementSeconds" class="form-select mb-3"><option value="0">@Localizer["No increment"]</option>@foreach (var seconds in new[] { 1, 2, 3, 5, 10, 15, 30 }) { <option value="@seconds">@string.Format(Localizer["{0} seconds"].Value, seconds)</option> }</select>
                    <div class="form-check mb-2"><input id="room-public" name="Public" class="form-check-input" type="checkbox" /><label for="room-public" class="form-check-label">@Localizer["List this room publicly"]</label></div>
                    <div class="form-check mb-3"><input id="room-random" name="RandomColors" class="form-check-input" type="checkbox" /><label for="room-random" class="form-check-label">@Localizer["Randomize colors at start"]</label></div>
                    <button data-room-host class="btn btn-outline-primary mb-3" type="submit">@Localizer["Save settings"]</button>
                </fieldset>
            </form>
            <details class="small text-muted mt-2"><summary>@Localizer["Room rules"]</summary><p>@Localizer["Only the two players can send chat messages. The host can drag people between seats and observers."]</p><p>@Localizer["The next human becomes host when the host leaves. The room closes when everyone leaves. Refreshing or reconnecting has a 60-second grace period."]</p></details>
        </aside>
    </div>
    <dialog id="room-share" class="room-dialog" aria-labelledby="room-share-title">
        <div class="d-flex align-items-center justify-content-between mb-3"><h2 id="room-share-title" class="h5 mb-0">@Localizer["Share room"]</h2><button id="close-room-share" class="btn-close" type="button" aria-label="@Localizer["Close"]"></button></div>
        <label class="form-label" for="room-link">@Localizer["Invitation link"]</label>
        <div class="input-group"><input id="room-link" class="form-control" readonly value="@($"{Context.Request.Scheme}://{Context.Request.Host}/rooms/{Model.Id}")" /><button id="copy-room-link" class="btn btn-primary" type="button">@Localizer["Copy link"]</button></div>
    </dialog>
    <dialog id="room-people" class="room-dialog room-people" aria-labelledby="room-people-title"><div class="d-flex align-items-center justify-content-between mb-3"><h2 id="room-people-title" class="h5 mb-0">@Localizer["People"]</h2><button id="close-room-people" class="btn-close" type="button" aria-label="@Localizer["Close"]"></button></div></dialog>
    <dialog id="add-room-ai"><form id="add-ai-form">
        <h2 class="h5">@Localizer["Add AI"]</h2><input type="hidden" id="ai-seat" />
        <label for="ai-kind" class="form-label">@Localizer["AI type"]</label><select id="ai-kind" class="form-select mb-3"><option value="engine">@Localizer["Built-in engine — Lynx"]</option>@if (Model.Models.Length > 0) { <option value="llm">@Localizer["Large language model"]</option> }</select>
        @if (User.Identity?.IsAuthenticated != true) { <p><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">@Localizer["Sign in to add an LLM."]</a></p> }
        <div id="ai-difficulty-field"><label for="ai-difficulty" class="form-label">@Localizer["Difficulty"]</label><select id="ai-difficulty" class="form-select mb-3">@foreach (var level in Enumerable.Range(1, 8)) { <option value="@level">@level</option> }</select></div>
        <div id="ai-model-field" hidden><label for="ai-model" class="form-label">@Localizer["Model"]</label><select id="ai-model" class="form-select mb-3">@foreach (var modelId in Model.Models) { <option value="@modelId">@modelId</option> }</select></div>
        <button class="btn btn-primary" type="submit">@Localizer["Add AI"]</button><button id="cancel-room-ai" class="btn btn-outline-secondary" type="button">@Localizer["Cancel"]</button>
    </form></dialog>
    <form id="room-antiforgery" hidden>@Html.AntiForgeryToken()</form>
    <div id="room-loc" hidden>
        <span data-key="player-one">@Localizer["Player 1"]</span><span data-key="player-two">@Localizer["Player 2"]</span>
        <span data-key="drag">@Localizer["Drag to change role"]</span><span data-key="drop">@Localizer["Drop here"]</span>
        <span data-key="seconds">@Localizer["{0} seconds"].Value</span>
        <span data-key="waiting">@Localizer["Preparing"]</span><span data-key="playing">@Localizer["Playing"]</span><span data-key="finished">@Localizer["Finished"]</span>
        <span data-key="empty">@Localizer["Empty seat"]</span><span data-key="observer">@Localizer["Observer"]</span><span data-key="white">@Localizer["White"]</span><span data-key="black">@Localizer["Black"]</span><span data-key="host">@Localizer["Host"]</span>
        <span data-key="add-ai">@Localizer["Add AI"]</span><span data-key="remove-ai">@Localizer["Remove AI"]</span><span data-key="transfer">@Localizer["Make host"]</span><span data-key="kick">@Localizer["Kick from room"]</span>
        <span data-key="copied">@Localizer["Copied"]</span><span data-key="confirm-leave">@Localizer["Leave this room? Leaving an active game forfeits it. If everyone leaves, the room closes."]</span>
        <span data-key="confirm-interrupt">@Localizer["This will stop the current game without awarding a winner. Continue?"]</span><span data-key="confirm-replace">@Localizer["Remove this AI and replace it with the selected person?"]</span><span data-key="confirm-kick">@Localizer["Kick this person from the room? They cannot rejoin this room with the same identity."]</span>
        <span data-key="room-unavailable">@Localizer["This room has closed. Return to the lobby."]</span><span data-key="room-kicked">@Localizer["You have been removed from this room."]</span><span data-key="room-stale">@Localizer["The room changed. Review the current settings and try again."]</span>
        <span data-key="room-sign-in-required">@Localizer["Sign in to add an LLM."]</span>
        <span data-key="room-host-only">@Localizer["Only the host can manage this room."]</span><span data-key="room-two-players">@Localizer["Fill both player seats before starting."]</span><span data-key="room-locked">@Localizer["Finish the current game before changing these settings."]</span><span data-key="room-settings-invalid">@Localizer["Choose valid room settings."]</span>
        <span data-key="room-seat-occupied">@Localizer["This seat is occupied. Move or remove its player first."]</span><span data-key="room-member-missing">@Localizer["This person has left the room."]</span><span data-key="room-model-unavailable">@Localizer["The selected model is unavailable. Refresh and try again."]</span><span data-key="error">@Localizer["Could not update the room. Please try again."]</span>
    </div>
</div>
@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script type="module" src="~/scripts/managed-room.js" asp-append-version="true"></script>
    @if (Model.Game != null) {
        <script src="~/node_modules/jquery/dist/jquery.min.js"></script>
        <script src="~/node_modules/%40chrisoakman/chessboardjs/dist/chessboard-1.0.0.min.js"></script>
        <script type="module" src="~/scripts/game.js" asp-append-version="true"></script>
    }
}
