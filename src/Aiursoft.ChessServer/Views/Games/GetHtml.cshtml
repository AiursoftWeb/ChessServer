@model Aiursoft.ChessServer.Models.ViewModels.RoomViewModel
@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/node_modules/%40chrisoakman/chessboardjs/dist/chessboard-1.0.0.min.css" />
    <link rel="stylesheet" href="~/css/chess.css" asp-append-version="true" />
    <link rel="modulepreload" href="~/scripts/chessboard/chessboard.js" asp-append-version="true" data-chess-module="board" />
    <link rel="modulepreload" href="~/scripts/chessboard/defaultConfig.js" asp-append-version="true" data-chess-module="config" />
    <link rel="modulepreload" href="~/scripts/chessboard/sound.js" asp-append-version="true" data-chess-module="sound" />
    <link rel="modulepreload" href="~/node_modules/chess.js/dist/esm/chess.js" asp-append-version="true" data-chess-module="rules" />
}
<div id="game-room" data-game-id="@Model.Id">
    <div id="chess-loc" hidden>
        <span data-key="closed">@Localizer["Connection closed. Refresh to reconnect."]</span>
        <span data-key="unavailable">@Localizer["Room unavailable. Return to the lobby."]</span>
        <span data-key="white">@Localizer["White"]</span>
        <span data-key="black">@Localizer["Black"]</span>
        <span data-key="spectator">@Localizer["Spectator"]</span>
        <span data-key="role">@Localizer["You are playing {0}."].Value</span>
        <span data-key="watching">@Localizer["You are watching this game."]</span>
        <span data-key="turn">@Localizer["{0} to move"].Value</span>
        <span data-key="check">@Localizer["{0} is in check"].Value</span>
        <span data-key="winner">@Localizer["Checkmate. {0} wins."].Value</span>
        <span data-key="draw">@Localizer["Game over — draw."]</span>
    </div>
    <h1 id="versus-info" class="h3 mb-4">@Model.Message</h1>
    <div class="row g-4">
        <div class="col-lg-7"><div class="card"><div class="card-body">
            <div id="board" class="w-100"></div>
            <p id="status" class="mt-3" role="status"></p>
            <p id="role" class="text-muted"></p>
            <audio src="/sounds/chess_piece_move.mp3" id="pieceMoveSound"></audio>
            <a asp-action="GetPgn" asp-route-id="@Model.Id">@Localizer["Export PGN"]</a>
        </div></div></div>
        <div class="col-lg-5"><div class="card"><div class="card-body">
            <h2 class="h4">@Localizer["Chat"]</h2>
            <div id="messages-box" class="chess-messages" role="log" aria-live="polite"></div>
            <form id="chat-form" class="d-flex gap-2 mt-3">
                <input id="chat-input" class="form-control" maxlength="2000" aria-label="@Localizer["Message"]" autocomplete="off" />
                <button class="btn btn-primary" type="submit">@Localizer["Send"]</button>
            </form>
            <p id="chat-status" class="text-muted mt-2" role="status"></p>
        </div></div></div>
    </div>
</div>
@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/node_modules/jquery/dist/jquery.min.js"></script>
    <script src="~/node_modules/%40chrisoakman/chessboardjs/dist/chessboard-1.0.0.min.js"></script>
    <script type="module" src="~/scripts/game.js" asp-append-version="true"></script>
}
