@model Aiursoft.ChessServer.Models.ViewModels.HistoryViewModel
<h1 class="h3 mb-4">@Localizer["My games"]</h1>
<div class="card"><div class="card-body">
    <form method="get" id="history-date" class="d-flex gap-2 align-items-end mb-4">
        <div><label for="date" class="form-label">@Localizer["Date"]</label><input type="date" id="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <input type="hidden" name="offsetMinutes" id="offset-minutes" value="@Model.OffsetMinutes" />
        <button class="btn btn-primary" type="submit">@Localizer["Show games"]</button>
    </form>
    @if (Model.Games.Count == 0) { <p class="text-muted">@Localizer["No completed games on this date."]</p> }
    else
    {
        <div class="table-responsive"><table class="table align-middle">
            <thead><tr><th>@Localizer["Finished"]</th><th>@Localizer["White"]</th><th>@Localizer["Black"]</th><th>@Localizer["Result"]</th><th></th></tr></thead>
            <tbody>@foreach (var game in Model.Games)
            {
                <tr><td><time class="history-time" datetime="@game.FinishedAt.ToString("O")">@game.FinishedAt.ToString("HH:mm")</time></td><td>@game.WhiteName</td><td>@game.BlackName</td><td>@game.Result</td><td><a asp-action="Replay" asp-route-id="@game.Id">@Localizer["Replay"]</a></td></tr>
            }</tbody>
        </table></div>
    }
    <nav class="d-flex justify-content-between" aria-label="@Localizer["Pagination"]">
        @if (Model.Page > 1) { <a asp-action="Index" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-offsetMinutes="@Model.OffsetMinutes" asp-route-page="@(Model.Page - 1)">@Localizer["Previous"]</a> }
        @if (Model.HasMore) { <a class="ms-auto" asp-action="Index" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" asp-route-offsetMinutes="@Model.OffsetMinutes" asp-route-page="@(Model.Page + 1)">@Localizer["Next"]</a> }
    </nav>
</div></div>
@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts { <script src="~/scripts/history.js" asp-append-version="true" defer></script> }
