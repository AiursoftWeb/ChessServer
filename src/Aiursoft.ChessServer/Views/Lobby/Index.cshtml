@model Aiursoft.ChessServer.Models.ViewModels.LobbyViewModel
<partial name="_ChessIdentity" />
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@Localizer["Play chess"]</h1>
    @if (User.Identity?.IsAuthenticated == true)
    { <a class="btn btn-outline-primary" asp-controller="History" asp-action="Index">@Localizer["My games"]</a> }
</div>
@if (Model.MyGames.Count > 0)
{
    <div class="card mb-3"><div class="card-body"><h2 class="h5">@Localizer["Your current games"]</h2>
        @foreach (var game in Model.MyGames)
        { <a class="btn btn-primary me-2 mb-2" asp-controller="Games" asp-action="GetHtml" asp-route-id="@game.Key">@Localizer["Continue game"] — @game.Value.Message</a> }
    </div></div>
}
<form asp-controller="Rooms" asp-action="Create" method="post" class="mb-4"><button class="btn btn-primary" type="submit">@Localizer["Create room"]</button></form>
<div class="card mb-4"><div class="card-body"><h2 class="h5">@Localizer["Rooms"]</h2>
    @if (Model.Rooms.Count == 0) { <p class="text-muted mb-0">@Localizer["No rooms yet. Create one and invite people."]</p> }
    @foreach (var item in Model.Rooms) {
        var room = (Aiursoft.ChessServer.Models.ManagedRoom)item.Value;
        <a class="d-block py-2" asp-controller="Rooms" asp-action="Room" asp-route-id="@item.Key">@room.Message — @room.Creator.NickName · @((room.White == null ? 0 : 1) + (room.Black == null ? 0 : 1))/2 · @if (Model.RoomStates[item.Key] == "waiting") { @Localizer["Preparing"] } else if (Model.RoomStates[item.Key] == "playing") { @Localizer["Playing"] } else { @Localizer["Finished"] }</a>
    }
</div></div>
<div class="card mt-4"><div class="card-body">
    <h2 class="h4">@Localizer["Open challenges"]</h2>
    @if (Model.OpenChallenges.Count == 0) { <p class="text-muted mb-0">@Localizer["No open challenges."]</p> }
    @foreach (var room in Model.OpenChallenges)
    {
        <a class="d-block py-2" asp-controller="Challenges" asp-action="Challenge" asp-route-id="@room.Key">@room.Value.Creator.NickName @if (room.Value.Creator.IsGuest) { <span class="badge bg-secondary">@Localizer["Guest"]</span> } — @room.Value.Message</a>
    }
</div></div>
<div class="card"><div class="card-body">
    <h2 class="h4">@Localizer["Watch a game"]</h2>
    @if (Model.OngoingChallenges.Count == 0) { <p class="text-muted mb-0">@Localizer["No games in progress."]</p> }
    @foreach (var room in Model.OngoingChallenges)
    {
        <a class="d-block py-2" asp-controller="Games" asp-action="GetHtml" asp-route-id="@room.Key">@room.Value.Creator.NickName @if (room.Value.Creator.IsGuest) { <span class="badge bg-secondary">@Localizer["Guest"]</span> } — @room.Value.Message</a>
    }
</div></div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script type="module" src="~/scripts/pve.js" asp-append-version="true"></script>
    <script type="module" src="~/scripts/time-control.js" asp-append-version="true"></script>
}
