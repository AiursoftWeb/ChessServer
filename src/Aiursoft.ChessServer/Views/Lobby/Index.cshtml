@model Aiursoft.ChessServer.Models.ViewModels.LobbyViewModel
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@Localizer["Play chess"]</h1>
    <a class="btn btn-outline-primary" asp-controller="History" asp-action="Index">@Localizer["My games"]</a>
</div>
@if (Model.MyGames.Count > 0)
{
    <div class="card mb-3"><div class="card-body"><h2 class="h5">@Localizer["Your current games"]</h2>
        @foreach (var game in Model.MyGames)
        { <a class="btn btn-primary me-2 mb-2" asp-controller="Games" asp-action="GetHtml" asp-route-id="@game.Key">@Localizer["Continue game"] — @game.Value.Message</a> }
    </div></div>
}
<div class="row g-4">
    <div class="col-md-6"><div class="card h-100"><div class="card-body">
        <h2 class="h4">@Localizer["Play against computer"]</h2>
        <form asp-controller="Pve" asp-action="New" method="post">
            <label for="difficulty" class="form-label">@Localizer["Difficulty"]</label>
            <select id="difficulty" name="difficulty" class="form-select mb-3">
                <option value="1">@Localizer["1 — Beginner"]</option>
                <option value="2">@Localizer["2 — Easy"]</option>
                <option value="3">@Localizer["3 — Casual"]</option>
                <option value="4">@Localizer["4 — Intermediate"]</option>
                <option value="5">@Localizer["5 — Challenging"]</option>
                <option value="6">@Localizer["6 — Hard"]</option>
                <option value="7">@Localizer["7 — Expert"]</option>
                <option value="8">@Localizer["8 — Strongest"]</option>
            </select>
            <label for="roleRule" class="form-label">@Localizer["Your pieces"]</label>
            <select id="roleRule" name="roleRule" class="form-select mb-3">
                <option value="0">@Localizer["White"]</option>
                <option value="1">@Localizer["Black"]</option>
                <option value="2">@Localizer["Random"]</option>
            </select>
            <label for="minutes" class="form-label">@Localizer["Time per player"]</label>
            <select id="minutes" name="minutes" class="form-select mb-3">
        <option value="0">@Localizer["Unlimited"]</option>
        <option value="3">@Localizer["3 minutes"]</option>
        <option value="5">@Localizer["5 minutes"]</option>
        <option value="10">@Localizer["10 minutes"]</option>
        <option value="15">@Localizer["15 minutes"]</option>
            </select>
    <label for="incrementSeconds" class="form-label">@Localizer["Increment per move"]</label>
    <select id="incrementSeconds" name="incrementSeconds" class="form-select mb-3" data-time-increment>
        <option value="0">@Localizer["No increment"]</option>
        <option value="1">@Localizer["1 second"]</option>
        <option value="2">@Localizer["2 seconds"]</option>
        <option value="3">@Localizer["3 seconds"]</option>
        <option value="5">@Localizer["5 seconds"]</option>
        <option value="10">@Localizer["10 seconds"]</option>
        <option value="15">@Localizer["15 seconds"]</option>
        <option value="30">@Localizer["30 seconds"]</option>
    </select>
            <button class="btn btn-primary" type="submit">@Localizer["Start game"]</button>
        </form>
    </div></div></div>
    <div class="col-md-6"><div class="card h-100"><div class="card-body">
        <h2 class="h4">@Localizer["Play with a friend"]</h2>
        <a class="btn btn-primary" asp-controller="Challenges" asp-action="Create">@Localizer["Create a challenge"]</a>
    </div></div></div>
</div>
<div class="card mt-4"><div class="card-body">
    <h2 class="h4">@Localizer["Open challenges"]</h2>
    @if (Model.OpenChallenges.Count == 0) { <p class="text-muted mb-0">@Localizer["No open challenges."]</p> }
    @foreach (var room in Model.OpenChallenges)
    {
        <a class="d-block py-2" asp-controller="Challenges" asp-action="Challenge" asp-route-id="@room.Key">@room.Value.Creator.NickName — @room.Value.Message</a>
    }
</div></div>
<div class="card"><div class="card-body">
    <h2 class="h4">@Localizer["Watch a game"]</h2>
    @if (Model.OngoingChallenges.Count == 0) { <p class="text-muted mb-0">@Localizer["No games in progress."]</p> }
    @foreach (var room in Model.OngoingChallenges)
    {
        <a class="d-block py-2" asp-controller="Games" asp-action="GetHtml" asp-route-id="@room.Key">@room.Value.Creator.NickName — @room.Value.Message</a>
    }
</div></div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script type="module" src="~/scripts/time-control.js" asp-append-version="true"></script>
}
