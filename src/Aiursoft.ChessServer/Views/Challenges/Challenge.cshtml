@model Aiursoft.ChessServer.Models.ViewModels.RoomViewModel
<h1 class="h3">@Model.Message</h1>
    @if (Model.PreferredMinutes.HasValue)
    {
        <p class="text-muted small">@string.Format(@Localizer["Time per player: {0} minutes."].Value, Model.PreferredMinutes)</p>
    }
<div id="chess-room" class="card" data-room-id="@Model.Id" data-disconnected="@Localizer["Connection closed. Refresh to reconnect."]"><div class="card-body">
    <p>@Localizer["Share this page with your opponent. Both players must sign in."]</p>
    <input class="form-control mb-3" aria-label="@Localizer["Room link"]" value="@($"{Context.Request.Scheme}://{Context.Request.Host}/challenge/{Model.Id}")" readonly />
    @if (Model.IsCreator)
    {
        <p>@Localizer["Waiting for your opponent…"]</p>
        <form asp-action="Drop" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-danger" type="submit">@Localizer["Cancel challenge"]</button></form>
    }
    else
    {
        <form asp-action="Accept" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary" type="submit">@Localizer["Accept challenge"]</button></form>
    }
    <p id="connection-status" class="text-muted mt-3 mb-0" role="status"></p>
</div></div>
@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/scripts/room.js" asp-append-version="true" defer></script>
}
