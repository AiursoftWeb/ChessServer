<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.ChessServer</AssemblyName>
    <RootNamespace>Aiursoft.ChessServer</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.ClickhouseLoggerProvider" Version="10.0.28" />
    <PackageReference Include="Aiursoft.DbTools.Switchable" Version="10.0.30" />
    <PackageReference Include="Aiursoft.Scanner" Version="10.0.15" />
    <PackageReference Include="Aiursoft.UiStack" Version="10.0.33" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.154.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.Canon.ScheduledTasks" Version="10.0.18" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aiursoft.ChessServer.InMemory\Aiursoft.ChessServer.InMemory.csproj" />
    <ProjectReference Include="..\Aiursoft.ChessServer.MySql\Aiursoft.ChessServer.MySql.csproj" />
    <ProjectReference Include="..\Aiursoft.ChessServer.Sqlite\Aiursoft.ChessServer.Sqlite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.AiurObserver.WebSocket.Server" Version="10.0.16" />
    <PackageReference Include="Aiursoft.GptClient" Version="10.0.28" />
    <PackageReference Include="Gera.Chess" Version="1.2.0" />
    <PackageReference Include="LynxChess.Lynx" Version="1.11.0" />
  </ItemGroup>
</Project>
